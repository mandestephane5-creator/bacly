{
  "name": "Bacly Admin",
  "short_name": "Bacly Admin",
  "description": "Déposer des sujets du BAC de partout ; le PC les classe et les publie dans Bacly.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#061417",
  "theme_color": "#061417",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "fichiers", "accept": ["application/pdf", "image/jpeg", "image/png", ".pdf", ".jpg", ".jpeg", ".png"] }] }
  }
}
